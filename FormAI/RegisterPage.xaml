<Window x:Class="FormAI.RegisterPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FormAI" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
        
        <Window.Resources>
        <!-- Just the background -->
        <LinearGradientBrush x:Key="BackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1A1D1F" Offset="0"/>
            <GradientStop Color="#2B2E30" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>
    
    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="10">
        <Grid>
            <!-- Simple title bar -->
            <Grid Height="30" VerticalAlignment="Top" Background="#2B2E30" 
                  MouseLeftButtonDown="TitleBar_MouseDown">
                <TextBlock Text="FormAI - Register" 
                           Foreground="White" 
                           VerticalAlignment="Center" 
                           Margin="15,0,0,0"/>
                <Button Content="X" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Top"
                        Width="30" Height="30"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Click="CloseButton_Click"/>
            </Grid>
            
            <!-- Form content -->
            <StackPanel Margin="40,60,40,40" >
                <TextBlock Text="Create Account" 
                           FontSize="24" 
                           Foreground="White" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>
                
                <TextBlock Text="Full Name:" Foreground="White"/>
                <TextBox x:Name="FullNameBox" Height="35" Padding="10"/>
                
                <TextBlock Text="Email:" Foreground="White"/>
                <TextBox x:Name="EmailBox" Height="35" Padding="10"/>
                
                <TextBlock Text="Password:" Foreground="White"/>
                <PasswordBox x:Name="PasswordBox" Height="35" Padding="10"/>
                
                <TextBlock Text="Confirm Password:" Foreground="White"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Height="35" Padding="10"/>
                
                <Button x:Name="RegisterButton" 
                        Content="Register" 
                        Height="40" 
                        Margin="0,20,0,0"
                        Background="#8B5CF6"
                        Foreground="White"
                        BorderThickness="0"
                        Click="RegisterButton_Click"/>
                
                <Button x:Name="BackToLoginButton" 
                        Content="Already have an account? Login" 
                        Background="Transparent"
                        Foreground="#8B5CF6"
                        BorderThickness="0"
                        Click="BackToLoginButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>



</Window>
