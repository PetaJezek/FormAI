<local:BaseWindow x:Class="FormAI.RegisterPage"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:FormAI"
                  Title="FormAI - Register" Height="800" Width="1200"
                  WindowStartupLocation="CenterScreen"
                  Style="{StaticResource BaseWindowStyle}">
    
    <Grid Background="{StaticResource MainBackgroundBrush}">
        <!-- Title Bar -->
        <Grid Height="35" VerticalAlignment="Top" Background="{StaticResource TitleBarBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- App Title -->
            <TextBlock Text="FormAI - Register" 
                       Grid.Column="0"
                       Style="{StaticResource TitleTextStyle}"/>
            
            <!-- Window Controls -->
            <StackPanel Grid.Column="1" 
                        Orientation="Horizontal" 
                        VerticalAlignment="Top">
                <Button x:Name="MinimizeButton" 
                        Content="&#xE921;" 
                        Style="{StaticResource WindowControlButton}"
                        Click="MinimizeButton_Click"/>
                <Button x:Name="MaximizeButton" 
                        Content="&#xE922;" 
                        Style="{StaticResource WindowControlButton}"
                        Click="MaximizeButton_Click"/>
                <Button x:Name="CloseButton" 
                        Content="&#xE8BB;" 
                        Style="{StaticResource CloseButton}"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
        
        <!-- Form Content -->
        <Grid Margin="0,35,0,0">
            <!-- Animated bubbles canvas -->
            <Canvas x:Name="BubblesCanvas" ClipToBounds="True">
                <!-- Bubbles will be added programmatically if needed -->
            </Canvas>
            
            <!-- Registration Form -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
                <!-- FormAI Logo (smaller) -->
                <TextBlock Text="FormAI" 
                           Style="{StaticResource LogoStyle}"
                           FontSize="48"
                           Margin="0,0,0,40"/>
                
                <!-- Form Title -->
                <TextBlock Text="Create Account" 
                           FontSize="28" 
                           FontWeight="Bold"
                           Foreground="White" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>
                
                <!-- Full Name -->
                <TextBlock Text="Full Name:" 
                           Foreground="#CCCCCC" 
                           FontSize="14"
                           Margin="0,0,0,5"/>
                <TextBox x:Name="FullNameBox" 
                         Height="40" 
                         Padding="15,10"
                         FontSize="14"
                         Margin="0,0,0,15"
                         Background="#404040"
                         Foreground="White"
                         BorderBrush="#8B5CF6"
                         BorderThickness="1"/>
                
                <!-- Email -->
                <TextBlock Text="Email:" 
                           Foreground="#CCCCCC" 
                           FontSize="14"
                           Margin="0,0,0,5"/>
                <TextBox x:Name="EmailBox" 
                         Height="40" 
                         Padding="15,10"
                         FontSize="14"
                         Margin="0,0,0,15"
                         Background="#404040"
                         Foreground="White"
                         BorderBrush="#8B5CF6"
                         BorderThickness="1"/>
                
                <!-- Password -->
                <TextBlock Text="Password:" 
                           Foreground="#CCCCCC" 
                           FontSize="14"
                           Margin="0,0,0,5"/>
                <PasswordBox x:Name="PasswordBox" 
                             Height="40" 
                             Padding="15,10"
                             FontSize="14"
                             Margin="0,0,0,15"
                             Background="#404040"
                             Foreground="White"
                             BorderBrush="#8B5CF6"
                             BorderThickness="1"/>
                
                <!-- Confirm Password -->
                <TextBlock Text="Confirm Password:" 
                           Foreground="#CCCCCC" 
                           FontSize="14"
                           Margin="0,0,0,5"/>
                <PasswordBox x:Name="ConfirmPasswordBox" 
                             Height="40" 
                             Padding="15,10"
                             FontSize="14"
                             Margin="0,0,0,25"
                             Background="#404040"
                             Foreground="White"
                             BorderBrush="#8B5CF6"
                             BorderThickness="1"/>
                
                <!-- Register Button -->
                <Button x:Name="RegisterButton" 
                        Content="Create Account" 
                        Style="{StaticResource StartButtonStyle}"
                        Height="50"
                        Width="200"
                        FontSize="16"
                        Margin="0,0,0,20"
                        Click="RegisterButton_Click"/>
                
                <!-- Back to Login -->
                <TextBlock HorizontalAlignment="Center">
                    <Run Text="Already have an account? " Foreground="#CCCCCC"/>
                    <Run x:Name="BackToLoginLink" 
                         Text="Sign In" 
                         Foreground="#8B5CF6" 
                         TextDecorations="Underline"
                         Cursor="Hand"
                         MouseLeftButtonUp="BackToLoginButton_Click"/>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Grid>
</local:BaseWindow>