<local:BaseWindow x:Class="FormAI.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:FormAI"
                  Title="FormAI" Height="800" Width="1200"
                  WindowStartupLocation="CenterScreen"
                  Style="{StaticResource BaseWindowStyle}">
    
    <Grid Background="{StaticResource MainBackgroundBrush}">
        <!-- Title Bar -->
        <Grid Height="35" 
              VerticalAlignment="Top" 
              Background="{StaticResource TitleBarBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- App Title -->
            <TextBlock Text="FormAI" 
                       Grid.Column="0"
                       Style="{StaticResource TitleTextStyle}"/>
            
            <!-- Window Controls -->
            
            <StackPanel Grid.Column="1" 
                        
                        Orientation="Horizontal" 
                        VerticalAlignment="Top">
                <Button x:Name="MinimizeButton" 
                        Content="&#xE921;" 
                        Style="{StaticResource WindowControlButton}"
                        Click="MinimizeButton_Click"/>
                <Button x:Name="MaximizeButton" 
                        Content="&#xE922;" 
                        Style="{StaticResource WindowControlButton}"
                        Click="MaximizeButton_Click"/>
                <Button x:Name="CloseButton" 
                        Content="&#xE8BB;" 
                        Style="{StaticResource CloseButton}"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
        
        <!-- Main Content Area -->
        <Grid Margin="0,35,0,0" MouseLeftButtonDown="Root_MouseLeftButtonDown">
            
            <!-- Main content -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- FormAI Logo -->
                <TextBlock x:Name="LogoText" 
                           Text="FormAI" 
                           Style="{StaticResource LogoStyle}"
                           Margin="0,0,0,80">
                    
                    <TextBlock.Effect>
                        <DropShadowEffect x:Name="LogoShadow" Color="{StaticResource Purple1}" BlurRadius="30" ShadowDepth="0" Opacity="0.6"/>
                    </TextBlock.Effect>
                    
                    <!-- Logo glow animation -->
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard Storyboard="{StaticResource LogoGlowAnimation}"/>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
                
                <!-- Start Button -->
                <Button x:Name="StartButton" 
                        Content="Start Your Journey" 
                        Style="{StaticResource StartButtonStyle}"
                        Click="StartButton_Click"/>
                
                <!-- Auth Buttons -->
                <StackPanel x:Name="AuthButtonsPanel" 
                           Orientation="Horizontal"
                           Visibility="Collapsed"
                           HorizontalAlignment="Center">
                    <Button x:Name="RegisterButton" 
                            Content="Register" 
                            Style="{StaticResource FilledAuthButtonStyle}"
                            Click="RegisterButton_Click"/>
                    
                    <Button x:Name="LoginButton" 
                            Content="Log In" 
                            Style="{StaticResource OutlineAuthButtonStyle}"
                            Click="LoginButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</local:BaseWindow>