<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Base Window Style -->
    <Style x:Key="BaseWindowStyle" TargetType="Window">
        <!-- REMOVED: <Setter Property="WindowStartupLocation" Value="CenterScreen"/> -->
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="AllowsTransparency" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="ResizeMode" Value="CanResizeWithGrip"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>
    
    <!-- Title Bar Style -->
    <Style x:Key="TitleBarStyle" TargetType="Grid">
        <Setter Property="Height" Value="35"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Background" Value="{StaticResource TitleBarBrush}"/>
    </Style>
    
    <!-- Title Text Style -->
    <Style x:Key="TitleTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="15,0,0,0"/>
        <Setter Property="Foreground" Value="{StaticResource LightGrayBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    
    <!-- Main Content Grid Style -->
    <Style x:Key="ContentGridStyle" TargetType="Grid">
        <Setter Property="Background" Value="{StaticResource MainBackgroundBrush}"/>
    </Style>
    
    <!-- Bubble Style -->
    <Style x:Key="BubbleStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Fill" Value="{StaticResource BubbleGradientBrush}"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{StaticResource Purple1}" BlurRadius="15" ShadowDepth="0" Opacity="0.4"/>
            </Setter.Value>
        </Setter>
    </Style>
    
</ResourceDictionary>