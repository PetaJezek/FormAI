<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Markdig" Version="0.42.0" />
      <PackageReference Include="MaterialDesignThemes" Version="5.3.0-ci1097" />
      <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3530-prerelease" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Fonts\" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Fonts\Inter-Italic-VariableFont_opsz,wght.ttf" />
      <Resource Include="Fonts\Inter-Italic-VariableFont_opsz,wght.ttf" />
      <None Remove="Fonts\Inter-VariableFont_opsz,wght.ttf" />
      <Resource Include="Fonts\Inter-VariableFont_opsz,wght.ttf" />
    </ItemGroup>
</Project>
