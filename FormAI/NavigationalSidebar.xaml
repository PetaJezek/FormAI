<!-- NavigationSidebar.xaml -->
<UserControl x:Class="FormAI.NavigationSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#2A2A2A">
    <StackPanel Margin="10" Width="200">
        <Button Content="📅 Calendar"  
                Style="{StaticResource FilledAuthButtonStyle}"
                Width="180"
                Height="45"
                FontSize="14"
                Margin="0,0,0,12" 
                Click="CalendarButton_Click"/>
                
        <Button Content="👤 Profile"     
                Style="{StaticResource OutlineAuthButtonStyle}"
                Width="180"
                Height="45"
                FontSize="14"
                Margin="0,0,0,12" 
                Click="ProfileButton_Click"/>
                
        <Button Content="🍽️ Saved Meals"     
                Style="{StaticResource OutlineAuthButtonStyle}"
                Width="180"
                Height="45"
                FontSize="14"
                Margin="0,0,0,12" 
                Click="MealsButton_Click"/>
                
        <Button Content="💪 Saved Exercises"     
                Style="{StaticResource OutlineAuthButtonStyle}"
                Width="180"
                Height="45"
                FontSize="14"
                Margin="0,0,0,12" 
                Click="ExerciseButton_Click"/>
                
        <Button Content="Preferences"  
                Style="{StaticResource OutlineAuthButtonStyle}"
                Width="180"
                Height="45"
                FontSize="14"
                Margin="0,0,0,12" 
                Click="SettingsButton_Click"/>
        <Button Content="Log Out"  
                Style="{StaticResource OutlineAuthButtonStyle}"
                Width="180"
                Height="45"
                FontSize="14"
                Margin="0,0,0,12" 
                Click="LogOutButton_Click"/>
    </StackPanel>
</UserControl>