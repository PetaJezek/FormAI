<local:BaseWindow x:Class="FormAI.ProfilePage"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:FormAI"
                  xmlns:controls="clr-namespace:FormAI"
                  Title="FormAI - Profile" Height="800" Width="1200"
                  WindowStartupLocation="CenterScreen"
                  Style="{StaticResource BaseWindowStyle}">

    <Grid Background="{StaticResource MainBackgroundBrush}">
        <!-- Title Bar -->
        <Grid Height="35" VerticalAlignment="Top" Background="{StaticResource TitleBarBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="FormAI - Profile" Grid.Column="0" Style="{StaticResource TitleTextStyle}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="MinimizeButton" Content="&#xE921;" Style="{StaticResource WindowControlButton}" Click="MinimizeButton_Click"/>
                <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource WindowControlButton}" Click="MaximizeButton_Click"/>
                <Button x:Name="CloseButton" Content="&#xE8BB;" Style="{StaticResource CloseButton}" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Main Content with Sidebar -->
        <Grid Margin="0,35,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <controls:NavigationSidebar Grid.Column="0" x:Name="NavigationSidebar"/>

            <!-- Right content area -->
            <Grid Grid.Column="1" >
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <!-- Registration-like stacked form -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400" Margin="0,40">
                        <TextBlock Text="Edit Profile" 
                                   FontSize="28" 
                                   FontWeight="Bold"
                                   Foreground="White" 
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,30"/>

                        <!-- Gender -->
                        <TextBlock Text="Gender:" 
                                   Foreground="#CCCCCC" 
                                   FontSize="14"
                                   Margin="0,0,0,5"/>
                        <ComboBox x:Name="GenderComboBox"
                                  Height="40"
                                  Style="{StaticResource DarkComboBoxStyle}"/>

                        <!-- Goal -->
                        <TextBlock Text="Goal:" 
                                   Foreground="#CCCCCC" 
                                   FontSize="14"
                                   Margin="0,0,0,5"/>
                        <ComboBox x:Name="GoalComboBox"
                                  Height="40"
                                  Style="{StaticResource DarkComboBoxStyle}"/>

                        <!-- Height -->
                        <TextBlock Text="Height (cm):" 
                                   Foreground="#CCCCCC" 
                                   FontSize="14"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="HeightBox"
                                 Height="40" 
                                 Padding="15,10"
                                 FontSize="14"
                                 Margin="0,0,0,15"
                                 Background="#404040"
                                 Foreground="White"
                                 BorderBrush="#8B5CF6"
                                 BorderThickness="1"
                                 Text="{Binding Height, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                 PreviewTextInput="NumberOnly_PreviewTextInput"/>

                        <!-- Weight -->
                        <TextBlock Text="Weight (kg):" 
                                   Foreground="#CCCCCC" 
                                   FontSize="14"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="WeightBox"
                                 Height="40" 
                                 Padding="15,10"
                                 FontSize="14"
                                 Margin="0,0,0,15"
                                 Background="#404040"
                                 Foreground="White"
                                 BorderBrush="#8B5CF6"
                                 BorderThickness="1"
                                 Text="{Binding Weight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                 PreviewTextInput="NumberOnly_PreviewTextInput"/>

                        <!-- Age -->
                        <TextBlock Text="Age:" 
                                   Foreground="#CCCCCC" 
                                   FontSize="14"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="AgeBox"
                                 Height="40" 
                                 Padding="15,10"
                                 FontSize="14"
                                 Margin="0,0,0,20"
                                 Background="#404040"
                                 Foreground="White"
                                 BorderBrush="#8B5CF6"
                                 BorderThickness="1"
                                 Text="{Binding Age, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                 PreviewTextInput="NumberOnly_PreviewTextInput"/>

                        <!-- Save Button -->
                        <Button x:Name="SaveButton"
                                Content="Save"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="50"
                                Width="200"
                                FontSize="16"
                                HorizontalAlignment="Center"
                                Click="SaveButton_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</local:BaseWindow>