<local:BaseWindow x:Class="FormAI.PreferencePage"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:FormAI"
                  xmlns:controls="clr-namespace:FormAI"
                  Title="FormAI - Preferences" Height="800" Width="1200"
                  WindowStartupLocation="CenterScreen"
                  Style="{StaticResource BaseWindowStyle}">

    <Grid Background="{StaticResource MainBackgroundBrush}">
        <!-- Title Bar -->
        <Grid Height="35" VerticalAlignment="Top" Background="{StaticResource TitleBarBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="FormAI - Preferences" Grid.Column="0" Style="{StaticResource TitleTextStyle}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="MinimizeButton" Content="&#xE921;" Style="{StaticResource WindowControlButton}" Click="MinimizeButton_Click"/>
                <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource WindowControlButton}" Click="MaximizeButton_Click"/>
                <Button x:Name="CloseButton" Content="&#xE8BB;" Style="{StaticResource CloseButton}" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Main Content with Sidebar -->
        <Grid Margin="0,35,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <controls:NavigationSidebar Grid.Column="0" x:Name="NavigationSidebar"/>

            <!-- Right content area -->
            <Grid Grid.Column="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="450" Margin="0,40">
                        <!-- Title -->
                        <TextBlock Text="Food Preferences" 
                                   FontSize="28" 
                                   FontWeight="Bold"
                                   Foreground="White" 
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,30"/>

                        <!-- Allergies -->
                        <TextBlock Text="Allergies &amp; Intolerances:" 
                                   Foreground="#CCCCCC" 
                                   FontSize="14"
                                   Margin="0,20,0,5"/>
                        <TextBlock Text="List any ingredients the AI must avoid. Separate with commas." Foreground="#AAAAAA" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBox x:Name="AllergiesTextBox"
                                 MinHeight="100" 
                                 Padding="15,10"
                                 FontSize="14"
                                 Margin="0,0,0,15"
                                 Background="#404040"
                                 Foreground="White"
                                 BorderBrush="#8B5CF6"
                                 BorderThickness="1"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Text="{Binding Allergies, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Disliked Foods -->
                        <TextBlock Text="Disliked Foods:" 
                                   Foreground="#CCCCCC" 
                                   FontSize="14"
                                   Margin="0,20,0,5"/>
                        <TextBlock Text="List any ingredients the AI should try to avoid. Separate with commas." Foreground="#AAAAAA" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBox x:Name="DislikedFoodsTextBox"
                                 MinHeight="100" 
                                 Padding="15,10"
                                 FontSize="14"
                                 Margin="0,0,0,20"
                                 Background="#404040"
                                 Foreground="White"
                                 BorderBrush="#8B5CF6"
                                 BorderThickness="1"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Text="{Binding DislikedFoods, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Save Button -->
                        <Button x:Name="SaveButton"
                                Content="Save Preferences"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="50"
                                Width="250"
                                FontSize="16"
                                HorizontalAlignment="Center"
                                Margin="0,20,0,0"
                                Click="SaveButton_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</local:BaseWindow>