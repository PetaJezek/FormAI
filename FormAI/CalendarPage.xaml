<local:BaseWindow x:Class="FormAI.CalendarPage"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:FormAI"
                  xmlns:controls="clr-namespace:FormAI"
                  Title="FormAI - Calendar" Height="800" Width="1200"
                  WindowStartupLocation="CenterScreen"
                  Style="{StaticResource BaseWindowStyle}"
                  KeyDown="CalendarPage_KeyDown"> 
    
    <Grid Background="{StaticResource MainBackgroundBrush}">
        <!-- Title Bar  -->
        <Grid Height="35" VerticalAlignment="Top" Background="{StaticResource TitleBarBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="FormAI - Calendar" Grid.Column="0" Style="{StaticResource TitleTextStyle}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="MinimizeButton" Content="&#xE921;" Style="{StaticResource WindowControlButton}" Click="MinimizeButton_Click"/>
                <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource WindowControlButton}" Click="MaximizeButton_Click"/>
                <Button x:Name="CloseButton" Content="&#xE8BB;" Style="{StaticResource CloseButton}" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
        
        <!-- Main Content -->
        <Grid Margin="0,35,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <controls:NavigationSidebar Grid.Column="0" x:Name="NavigationSidebar"/>
            
            <!-- This Grid contains the main Calendar content area -->
            <Grid Grid.Column="1"  Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/> 
                </Grid.RowDefinitions>
                
                <!-- Header  -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,30">
                    <TextBlock Text="📅" FontSize="32" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBlock Text="Calendar" FontSize="36" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Day of Week Names -->
                <Grid Grid.Row="1" Margin="20,0,20,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Mon" HorizontalAlignment="Center" Foreground="#8B5CF6" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Grid.Column="1" Text="Tue" HorizontalAlignment="Center" Foreground="#8B5CF6" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Grid.Column="2" Text="Wed" HorizontalAlignment="Center" Foreground="#8B5CF6" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Grid.Column="3" Text="Thu" HorizontalAlignment="Center" Foreground="#8B5CF6" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Grid.Column="4" Text="Fri" HorizontalAlignment="Center" Foreground="#8B5CF6" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Grid.Column="5" Text="Sat" HorizontalAlignment="Center" Foreground="#FF6B6B" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Grid.Column="6" Text="Sun" HorizontalAlignment="Center" Foreground="#FF6B6B" FontWeight="Bold" FontSize="14"/>
                </Grid>
                
                <!-- The Calendar itself -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="20,0"> 
                    <ItemsControl x:Name="CalendarItemsControl" Margin="0,0,0,20">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding BackgroundColor}" BorderBrush="#404040" BorderThickness="1" Margin="2" CornerRadius="4">
                                    <Button Background="Transparent" BorderThickness="0" Click="DayButton_Click" Tag="{Binding Date}" Style="{StaticResource CalendarDayButtonStyle}"> 
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DayOfMonth}" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding DayOfWeek}" FontSize="12" Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                
                
                <Grid x:Name="SelectedDatePanel" 
                      Grid.RowSpan="3" 
                      Background="#CC000000" 
                      Visibility="Collapsed" 
                      MouseLeftButtonDown="Background_MouseLeftButtonDown">
                    
                    
                    <Border Background="#2D2D2D" 
                            Padding="30"
                            CornerRadius="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MouseLeftButtonDown="SelectedDatePanel_PreviewMouseLeftButtonDown">
                        
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="20" Color="Black" Opacity="0.8"/>
                        </Border.Effect>
                        
                        <StackPanel>
                            <TextBlock x:Name="SelectedDateText" 
                                       Text="Please select a day"
                                       FontSize="24" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" Margin="0,0,0,30"/>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="15">
                                <Button Content="View Meal Plan" 
                                        Style="{StaticResource FilledAuthButtonStyle}" 
                                        Width="140" Height="40" FontSize="14"
                                        Click="ViewMealPlan_Click"/>
                                <Button Content="Generate for a Day" 
                                        Style="{StaticResource FilledAuthButtonStyle}" 
                                        Width="140" Height="40" FontSize="14"
                                        Click="GenerateForDay_Click"/>
                                <Button Content="Generate for a Week" 
                                        Style="{StaticResource FilledAuthButtonStyle}" 
                                        Width="140" Height="40" FontSize="14"
                                        Click="GenerateForWeek_Click"/>
                                
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</local:BaseWindow>